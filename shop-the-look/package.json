{
  "name": "Shop The Look",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fastapi-dev": "pip3 install -r requirements.txt && python3 -m uvicorn api.index:app --reload",
    "next-dev": "npm install; next dev",
    "dev": "concurrently \"npm run next-dev\" \"npm run fastapi-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/node": "20.2.4",
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.4",
    "@vercel/analytics": "^1.3.1",
    "autoprefixer": "10.4.14",
    "axios": "^1.16.1",
    "concurrently": "^8.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "postcss": "8.5.26",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.3.2",
    "typescript": "5.0.4",
    "video.js": "^8.24.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4",
    "form-data": "^4.0.4",
    "@xmldom/xmldom": "^0.9.10",
    "lodash": "^4.18.1",
    "sharp": "^0.35.0",
    "postcss": "$postcss"
  }
